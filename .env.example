# TMDB API key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# SQLite database file (default: ./data/ott_brain.db)
OTT_BRAIN_DB_PATH=

# Skip TMDB detail re-fetch if movie row was updated within this many hours
MOVIE_METADATA_TTL_HOURS=168

# Provider cache TTL (default 7 days)
PROVIDER_CACHE_TTL_HOURS=168

# Availability backend: tmdb (default) or watchmode (stub)
AVAILABILITY_BACKEND=tmdb
